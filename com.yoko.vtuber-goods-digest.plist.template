<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd テンプレート。MacBook セットアップ時に以下を置換してから配置する:
    <USER> -> 実際のユーザー名（例: yoko）
  配置先: ~/Library/LaunchAgents/com.yoko.vtuber-goods-digest.plist
  登録:   launchctl load ~/Library/LaunchAgents/com.yoko.vtuber-goods-digest.plist
  解除:   launchctl unload ~/Library/LaunchAgents/com.yoko.vtuber-goods-digest.plist

  実行時刻は毎日 03:10 JST。tech_research(03:00実行)と同じpmset起床ウィンドウ(02:55起床)に
  相乗りさせるため、元Windowsタスクスケジューラの06:00から変更した。pmset repeatは起床予約を
  1つしか持てないため、複数ジョブは同じ起床ウィンドウにまとめる方針。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.yoko.vtuber-goods-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/<USER>/repos/vtuber_goods_digest/run_mac.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/<USER>/repos/vtuber_goods_digest/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/<USER>/repos/vtuber_goods_digest/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
